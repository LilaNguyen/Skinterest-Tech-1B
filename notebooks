      "outputs": [],
      "source": [
        "# drop any rows where 'is_recommended' is NaN\n",
        "merged_reviews_df = merged_reviews_df.dropna(subset=['is_recommended']).copy()\n",
        "\n",
        "# check labels are binary integers (0 or 1)\n",
        "merged_reviews_df['is_recommended'] = merged_reviews_df['is_recommended'].astype(int)\n",
        "\n",
        "# TF-IDF vectorization\n",
        "tfidf_vectorizer = TfidfVectorizer(stop_words='english', ngram_range=(1,2), min_df=5)\n",
        "\n",
        "# create labeled examples\n",
        "X = tfidf_vectorizer.fit_transform(merged_reviews_df[\"full_review\"])\n",
        "y = merged_reviews_df[\"is_recommended\"]\n",
        "\n",
        "# reduce TF-IDF features to 300 components\n",
        "svd = TruncatedSVD(n_components=300, random_state=42)\n",
        "X_reduced = svd.fit_transform(X)\n",
        "\n",
        "# create training & test datasets\n",
        "X_train, X_test, y_train, y_test = train_test_split(X_reduced, y, test_size=0.25, random_state=42)"
      ]
    },
    {
      "cell_type": "code",
