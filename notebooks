        "        # Remove leading/trailing spaces and non-alphanumeric characters\n",
        "        ingredient = re.sub(r'[^a-z ]', '', ingredient).strip()\n",
        "        if ingredient: # Only add if not an empty string after cleaning\n",
        "            cleaned_ingredients.append(ingredient)\n",
